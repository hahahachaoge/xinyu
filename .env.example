# Copy to .env.properties in the project root. Never overwrite existing credentials.
# Fill in your own values. See docs/environment.md for all variables and defaults.
# .env.properties is ignored by Git; launch Spring Boot from the backend directory.

# Required database credentials (use the accounts configured on your own machine).
MYSQL_USERNAME=root
MYSQL_PASSWORD=
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=

# Required for AI chat and knowledge embedding respectively. These are separate services.
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# Required for login. Generate a private random string of at least 32 characters.
JWT_SECRET=

# Optional deployment overrides (defaults keep local development working).
# Production uses the same-origin /api proxy when PUBLIC_API_URL is not set.
# PUBLIC_API_URL=/api
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/qa_mental_health_knowledge_services_adolescents?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# PGVECTOR_HOST=127.0.0.1
# PGVECTOR_PORT=5432
# PGVECTOR_DATABASE=qa_mental_health_knowledge_services_adolescents

# Production listens on loopback by default; leave this unset for same-host Nginx.
# SERVER_ADDRESS=127.0.0.1

# Demo profile only. Leave unset to keep the published user/admin test password.
# DEMO_ACCOUNT_PASSWORD=

# Copy this file to .env.properties in the project root, then fill in local values.
# .env.properties is ignored by Git and is loaded automatically by Spring Boot.
MYSQL_USERNAME=root
MYSQL_PASSWORD=
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

JWT_SECRET=

# Optional deployment overrides (defaults keep local development working).
# Production uses the same-origin /api proxy when PUBLIC_API_URL is not set.
# PUBLIC_API_URL=/api
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/qa_mental_health_knowledge_services_adolescents?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# PGVECTOR_HOST=127.0.0.1
# PGVECTOR_PORT=5432
# PGVECTOR_DATABASE=qa_mental_health_knowledge_services_adolescents
